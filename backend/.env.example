# Copy this file to backend/.env and adjust as needed.

# SQLite (default — no setup required)
DATABASE_URL=sqlite+aiosqlite:///./matchit.db

# PostgreSQL (recommended for shared / production use)
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/matchit

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Where uploaded files are stored (defaults to the OS temp directory)
# UPLOAD_DIR=/path/to/uploads

# LOG_LEVEL=INFO
